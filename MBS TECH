import React, { useState, useEffect } from 'react';
import { Camera, Youtube, Newspaper, User, Save, Plus, Trash2, Edit3, X, Menu, Upload, ExternalLink, Lock, LogOut, Loader2, CheckCircle, AlertCircle } from 'lucide-react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged, signInAnonymously, signInWithCustomToken } from 'firebase/auth';
import { getFirestore, doc, collection, onSnapshot, setDoc, addDoc, deleteDoc, updateDoc } from 'firebase/firestore';

// --- FIREBASE CONFIGURATION ---
// FOR GITHUB PAGES DEPLOYMENT: Replace the empty object below with your actual Firebase config keys.
const YOUR_FIREBASE_CONFIG = {
  // apiKey: "...",
  // authDomain: "...",
  // projectId: "...",
  // storageBucket: "...",
  // messagingSenderId: "...",
  // appId: "..."
};

// Internal Logic to handle both Canvas Preview and Live Deployment
const getFirebaseConfig = () => {
  if (typeof __firebase_config !== 'undefined') {
    return JSON.parse(__firebase_config);
  }
  return YOUR_FIREBASE_CONFIG;
};

const app = initializeApp(getFirebaseConfig());
const auth = getAuth(app);
const db = getFirestore(app);

// Helper to handle collection paths for both Preview and Production
const getCollectionRef = (collectionName) => {
  if (typeof __app_id !== 'undefined') {
    return collection(db, 'artifacts', __app_id, 'public', 'data', collectionName);
  }
  return collection(db, collectionName);
};

const getDocRef = (collectionName, docId) => {
  if (typeof __app_id !== 'undefined') {
    return doc(db, 'artifacts', __app_id, 'public', 'data', collectionName, docId);
  }
  return doc(db, collectionName, docId);
};

// --- DEFAULT DATA ---
const DEFAULT_PROFILE = {
  name: "Muhammad Bin Sajid",
  tagline: "Tech Reviewer | 14 Years Old",
  description: "Welcome to the official world of MBS TECH. I am a 14-year-old tech enthusiast and reviewer passionate about the latest gadgets, software updates, and the future of technology. Join me as I unbox, review, and explore the tech world.",
  youtubeUrl: "https://www.youtube.com/@MBSTECH",
  avatar: null
};

// --- COMPONENTS ---

const Toast = ({ message, type, onClose }) => (
  <div className={`fixed bottom-4 right-4 z-50 flex items-center gap-2 px-4 py-3 rounded-lg shadow-lg animate-in slide-in-from-bottom-5 ${type === 'error' ? 'bg-red-600 text-white' : 'bg-green-600 text-white'}`}>
    {type === 'error' ? <AlertCircle size={20} /> : <CheckCircle size={20} />}
    <span className="font-medium">{message}</span>
    <button onClick={onClose} className="ml-2 hover:bg-white/20 rounded-full p-1"><X size={14} /></button>
  </div>
);

export default function App() {
  const [user, setUser] = useState(null); 
  const [isAdmin, setIsAdmin] = useState(false); 
  const [isEditing, setIsEditing] = useState(false); 
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [activeSection, setActiveSection] = useState('home');
  const [showLoginModal, setShowLoginModal] = useState(false);
  const [isLoading, setIsLoading] = useState(true);
  
  // Feedback States
  const [toast, setToast] = useState(null); // { message, type }
  const [isUploading, setIsUploading] = useState(false);

  // Data States
  const [profile, setProfile] = useState(DEFAULT_PROFILE);
  const [news, setNews] = useState([]);
  const [gallery, setGallery] = useState([]);

  // Login Form States
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [authError, setAuthError] = useState('');

  // --- INITIALIZATION & AUTH ---
  useEffect(() => {
    const initAuth = async () => {
      if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
        await signInWithCustomToken(auth, __initial_auth_token);
      } else if (typeof __app_id !== 'undefined') {
         await signInAnonymously(auth);
      }
    };
    initAuth();

    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
      setIsAdmin(currentUser && !currentUser.isAnonymous); 
      setIsLoading(false);
    });
    return () => unsubscribe();
  }, []);

  // --- DATA FETCHING ---
  useEffect(() => {
    const profileUnsub = onSnapshot(getDocRef('content', 'profile'), (docSnap) => {
      if (docSnap.exists()) setProfile(docSnap.data());
      else if (isAdmin) setDoc(getDocRef('content', 'profile'), DEFAULT_PROFILE);
    });

    const newsUnsub = onSnapshot(getCollectionRef('news'), (snapshot) => {
      const newsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      newsData.sort((a, b) => new Date(b.date) - new Date(a.date));
      setNews(newsData);
    });

    const galleryUnsub = onSnapshot(getCollectionRef('gallery'), (snapshot) => {
      const galleryData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      galleryData.sort((a, b) => b.uploadedAt - a.uploadedAt);
      setGallery(galleryData);
    });

    return () => { profileUnsub(); newsUnsub(); galleryUnsub(); };
  }, [isAdmin]);

  // --- HANDLERS ---
  const showToast = (message, type = 'success') => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 3000);
  };

  const handleLogin = async (e) => {
    e.preventDefault();
    setAuthError('');
    try {
      await signInWithEmailAndPassword(auth, email, password);
      setShowLoginModal(false);
      setEmail('');
      setPassword('');
      showToast("Welcome back, Muhammad!");
    } catch (err) {
      setAuthError('Invalid credentials.');
    }
  };

  const handleLogout = async () => {
    await signOut(auth);
    setIsEditing(false);
    if (typeof __app_id !== 'undefined') await signInAnonymously(auth);
    showToast("Logged out successfully.");
  };

  const saveProfile = async (field, value) => {
    const updatedProfile = { ...profile, [field]: value };
    setProfile(updatedProfile); 
    try {
      await setDoc(getDocRef('content', 'profile'), updatedProfile);
    } catch (e) {
      showToast("Failed to save changes", "error");
    }
  };

  const handleImageUpload = (e, type) => {
    const file = e.target.files[0];
    if (file) {
      if (file.size > 800000) {
        showToast("Image too large (Max 800KB)", "error");
        return;
      }
      setIsUploading(true);
      const reader = new FileReader();
      reader.onloadend = async () => {
        const base64String = reader.result;
        try {
          if (type === 'avatar') {
            await saveProfile('avatar', base64String);
            showToast("Profile picture updated!");
          } else if (type === 'gallery') {
            await addDoc(getCollectionRef('gallery'), {
              src: base64String,
              caption: "Uploaded Image",
              uploadedAt: Date.now()
            });
            showToast("Image added to gallery!");
          }
        } catch (err) {
          showToast("Upload failed", "error");
        } finally {
          setIsUploading(false);
        }
      };
      reader.readAsDataURL(file);
    }
  };

  const addNewsItem = async () => {
    try {
      await addDoc(getCollectionRef('news'), {
        title: "New Update",
        date: new Date().toISOString().split('T')[0],
        content: "Click edit to change this text.",
        createdAt: Date.now()
      });
      showToast("New post created!");
    } catch (e) { showToast("Error creating post", "error"); }
  };

  const updateNewsItem = async (id, field, value) => {
    setNews(prev => prev.map(item => item.id === id ? { ...item, [field]: value } : item));
    try {
      await updateDoc(getDocRef('news', id), { [field]: value });
    } catch (e) { console.error(e); }
  };

  const deleteItem = async (collectionName, id) => {
    if (window.confirm("Are you sure you want to delete this?")) {
      try {
        await deleteDoc(getDocRef(collectionName, id));
        showToast("Item deleted.");
      } catch (e) { showToast("Error deleting item", "error"); }
    }
  };

  const NavLink = ({ name, id, icon: Icon }) => (
    <button
      onClick={() => { setActiveSection(id); setIsMenuOpen(false); }}
      className={`flex items-center space-x-2 px-4 py-2 rounded-lg transition-colors ${
        activeSection === id ? 'bg-blue-600 text-white' : 'text-gray-300 hover:bg-gray-800 hover:text-white'
      }`}
    >
      <Icon size={18} />
      <span>{name}</span>
    </button>
  );

  if (isLoading) return <div className="min-h-screen bg-gray-900 flex items-center justify-center text-white"><Loader2 className="animate-spin mr-2" /> Loading MBS TECH...</div>;

  return (
    <div className="min-h-screen bg-gray-900 text-gray-100 font-sans selection:bg-blue-500 selection:text-white pb-20">
      {toast && <Toast message={toast.message} type={toast.type} onClose={() => setToast(null)} />}
      
      {/* Navbar */}
      <nav className="sticky top-0 z-40 bg-gray-900/95 backdrop-blur border-b border-gray-800">
        <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex items-center justify-between h-16">
            <div className="flex items-center space-x-3 cursor-pointer" onClick={() => setActiveSection('home')}>
              <div className="bg-gradient-to-r from-blue-600 to-purple-600 p-2 rounded-lg shadow-lg shadow-blue-900/20">
                <Youtube size={24} className="text-white" />
              </div>
              <span className="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-purple-400">
                {profile.name}
              </span>
            </div>

            {/* Desktop Nav */}
            <div className="hidden md:flex items-center space-x-2">
              <NavLink name="Home" id="home" icon={User} />
              <NavLink name="News" id="news" icon={Newspaper} />
              <NavLink name="Photos" id="photos" icon={Camera} />
              
              {isAdmin && (
                <>
                  <div className="w-px h-6 bg-gray-700 mx-2"></div>
                  <button
                    onClick={() => setIsEditing(!isEditing)}
                    className={`flex items-center space-x-2 px-4 py-2 rounded-lg font-medium transition-all ${
                      isEditing ? 'bg-green-600 text-white shadow-lg shadow-green-900/20' : 'bg-gray-800 text-gray-300 hover:bg-gray-700'
                    }`}
                  >
                    {isEditing ? <><Save size={18} /><span>Done Editing</span></> : <><Edit3 size={18} /><span>Edit Site</span></>}
                  </button>
                  <button onClick={handleLogout} className="p-2 text-red-400 hover:bg-red-900/20 rounded-lg ml-2" title="Logout"><LogOut size={20} /></button>
                </>
              )}
            </div>

            {/* Mobile Menu Toggle */}
            <div className="md:hidden flex items-center gap-2">
              {isAdmin && (
                 <button onClick={() => setIsEditing(!isEditing)} className={`p-2 rounded-lg ${isEditing ? 'text-green-400' : 'text-gray-400'}`}>
                  {isEditing ? <Save size={20} /> : <Edit3 size={20} />}
                </button>
              )}
              <button onClick={() => setIsMenuOpen(!isMenuOpen)} className="p-2 text-gray-400">
                {isMenuOpen ? <X size={24} /> : <Menu size={24} />}
              </button>
            </div>
          </div>
        </div>

        {/* Mobile Nav Dropdown */}
        {isMenuOpen && (
          <div className="md:hidden bg-gray-800 border-b border-gray-700 p-2 space-y-1">
            <NavLink name="Home" id="home" icon={User} />
            <NavLink name="News" id="news" icon={Newspaper} />
            <NavLink name="Photos" id="photos" icon={Camera} />
            {isAdmin && (
               <button onClick={handleLogout} className="flex items-center space-x-2 px-4 py-2 rounded-lg text-red-400 w-full text-left">
                 <LogOut size={18} /><span>Logout</span>
               </button>
            )}
          </div>
        )}
      </nav>

      {/* Main Content */}
      <main className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        {/* HOME SECTION */}
        {activeSection === 'home' && (
          <div className="space-y-12 animate-in fade-in duration-500">
            {isAdmin && <div className="bg-blue-900/20 border border-blue-500/30 p-4 rounded-xl text-blue-200 text-sm flex items-center gap-2 mb-6"><Edit3 size={16}/> You are logged in as Admin. Click "Edit Site" to modify content.</div>}
            
            <div className="bg-gray-800 rounded-3xl p-8 md:p-12 shadow-2xl border border-gray-700 relative overflow-hidden">
              <div className="absolute top-0 right-0 w-64 h-64 bg-blue-600 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob"></div>
              <div className="absolute -bottom-8 -left-8 w-64 h-64 bg-purple-600 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob animation-delay-2000"></div>
              
              <div className="relative z-10 flex flex-col md:flex-row items-center gap-8 md:gap-12">
                <div className="relative group shrink-0">
                  <div className="w-40 h-40 md:w-56 md:h-56 rounded-full overflow-hidden border-4 border-blue-500/30 shadow-2xl relative bg-gray-700 flex items-center justify-center">
                    {profile.avatar ? <img src={profile.avatar} alt="Profile" className="w-full h-full object-cover" /> : <User size={64} className="text-gray-500" />}
                    {isEditing && (
                      <div className="absolute inset-0 bg-black/60 flex items-center justify-center hover:bg-black/70 transition-colors">
                        {isUploading ? <Loader2 className="animate-spin text-white" /> : (
                          <label className="cursor-pointer text-white flex flex-col items-center">
                            <Upload size={24} className="mb-2" /><span className="text-sm font-medium">Change</span>
                            <input type="file" className="hidden" accept="image/*" onChange={(e) => handleImageUpload(e, 'avatar')} />
                          </label>
                        )}
                      </div>
                    )}
                  </div>
                </div>

                <div className="flex-1 text-center md:text-left space-y-4 w-full">
                  <div>
                    {isEditing ? (
                      <input type="text" value={profile.name} onChange={(e) => saveProfile('name', e.target.value)} className="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-3xl md:text-5xl font-bold text-white mb-2" />
                    ) : (
                      <h1 className="text-3xl md:text-5xl font-bold text-white mb-2 tracking-tight">{profile.name}</h1>
                    )}
                    
                    {isEditing ? (
                      <input type="text" value={profile.tagline} onChange={(e) => saveProfile('tagline', e.target.value)} className="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-xl text-blue-400 font-medium" />
                    ) : (
                      <p className="text-xl text-blue-400 font-medium">{profile.tagline}</p>
                    )}
                  </div>

                  <div className="prose prose-invert max-w-none">
                     {isEditing ? (
                      <textarea value={profile.description} onChange={(e) => saveProfile('description', e.target.value)} className="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-gray-300 min-h-[120px]" />
                    ) : (
                      <p className="text-gray-300 leading-relaxed text-lg">{profile.description}</p>
                    )}
                  </div>

                  <div className="pt-4">
                     {isEditing ? (
                        <div className="flex items-center gap-2">
                           <Youtube className="text-red-500" />
                           <input type="text" value={profile.youtubeUrl} onChange={(e) => saveProfile('youtubeUrl', e.target.value)} className="flex-1 bg-gray-900 border border-gray-600 rounded px-3 py-2 text-sm text-gray-300" />
                        </div>
                     ) : (
                        <a href={profile.youtubeUrl} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-full font-bold transition-transform hover:scale-105 shadow-lg shadow-red-900/20">
                           <Youtube size={20} /><span>Visit MBS TECH</span><ExternalLink size={16} className="ml-1 opacity-70" />
                        </a>
                     )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* NEWS SECTION */}
        {activeSection === 'news' && (
          <div className="animate-in slide-in-from-bottom-4 duration-500">
            <div className="flex items-center justify-between mb-8">
              <h2 className="text-3xl font-bold text-white">Latest Tech News</h2>
              {isEditing && (
                <button onClick={addNewsItem} className="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg text-white font-medium transition-colors">
                  <Plus size={18} /> Add Post
                </button>
              )}
            </div>

            <div className="grid gap-6">
              {news.map((item) => (
                <div key={item.id} className="bg-gray-800 rounded-xl p-6 border border-gray-700 shadow-sm hover:border-gray-600 transition-colors group">
                  <div className="flex justify-between items-start mb-4">
                    <div className="flex-1">
                      {isEditing ? (
                        <input type="text" value={item.title} onChange={(e) => updateNewsItem(item.id, 'title', e.target.value)} className="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-xl font-bold text-white mb-2" placeholder="News Title" />
                      ) : (
                        <h3 className="text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">{item.title}</h3>
                      )}
                      
                      {isEditing ? (
                        <input type="date" value={item.date} onChange={(e) => updateNewsItem(item.id, 'date', e.target.value)} className="bg-gray-900 border border-gray-600 rounded px-2 py-1 text-sm text-gray-400" />
                      ) : (
                        <span className="text-sm text-gray-500 font-mono bg-gray-900/50 px-2 py-1 rounded">{item.date}</span>
                      )}
                    </div>
                    
                    {isEditing && (
                      <button onClick={() => deleteItem('news', item.id)} className="text-red-400 hover:bg-red-900/30 p-2 rounded-lg ml-4"><Trash2 size={20} /></button>
                    )}
                  </div>

                  {isEditing ? (
                    <textarea value={item.content} onChange={(e) => updateNewsItem(item.id, 'content', e.target.value)} className="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-gray-300 min-h-[100px]" placeholder="Write your news here..." />
                  ) : (
                    <p className="text-gray-300 leading-relaxed whitespace-pre-wrap">{item.content}</p>
                  )}
                </div>
              ))}
              {news.length === 0 && <div className="text-center py-12 bg-gray-800/50 rounded-xl border border-dashed border-gray-700 text-gray-400"><Newspaper size={48} className="mx-auto mb-4" />No news updates yet.</div>}
            </div>
          </div>
        )}

        {/* PHOTOS SECTION */}
        {activeSection === 'photos' && (
          <div className="animate-in slide-in-from-bottom-4 duration-500">
            <div className="flex items-center justify-between mb-8">
              <h2 className="text-3xl font-bold text-white">Gallery</h2>
              {isEditing && (
                 <label className="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg text-white font-medium transition-colors cursor-pointer">
                  {isUploading ? <Loader2 className="animate-spin" size={18} /> : <Upload size={18} />}
                  <span>{isUploading ? "Uploading..." : "Upload Image"}</span>
                  <input type="file" className="hidden" accept="image/*" onChange={(e) => handleImageUpload(e, 'gallery')} disabled={isUploading} />
                </label>
              )}
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
              {gallery.map((photo) => (
                <div key={photo.id} className="group relative aspect-video bg-gray-800 rounded-xl overflow-hidden border border-gray-700 shadow-lg">
                  <img src={photo.src} alt="Gallery" className="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                  {isEditing ? (
                     <div className="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <button onClick={() => deleteItem('gallery', photo.id)} className="bg-red-600 text-white p-3 rounded-full hover:scale-110 transition-transform"><Trash2 size={24} /></button>
                     </div>
                  ) : (
                     <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                        <p className="text-white font-medium">MBS Gallery</p>
                     </div>
                  )}
                </div>
              ))}
              {isEditing && !isUploading && (
                <label className="aspect-video bg-gray-800 rounded-xl border-2 border-dashed border-gray-600 hover:border-blue-500 hover:bg-gray-800/80 transition-all flex flex-col items-center justify-center cursor-pointer group">
                   <Plus size={48} className="text-gray-600 group-hover:text-blue-500 mb-2" /><span className="text-gray-400 group-hover:text-blue-400 font-medium">Add Photo</span>
                   <input type="file" className="hidden" accept="image/*" onChange={(e) => handleImageUpload(e, 'gallery')} />
                </label>
              )}
            </div>
            {gallery.length === 0 && !isEditing && <div className="text-center py-12 bg-gray-800/50 rounded-xl border border-dashed border-gray-700 text-gray-400"><Camera size={48} className="mx-auto mb-4" />Gallery is empty.</div>}
          </div>
        )}
      </main>

      {/* Footer */}
      <footer className="border-t border-gray-800 mt-20 bg-gray-900 py-8 relative">
        <div className="max-w-6xl mx-auto px-4 text-center">
          <p className="text-gray-500 mb-4">© {new Date().getFullYear()} {profile.name}. All rights reserved.</p>
          <div className="flex justify-center space-x-6">
            <a href={profile.youtubeUrl} target="_blank" rel="noopener noreferrer" className="text-gray-400 hover:text-red-500 transition-colors"><Youtube size={24} /></a>
          </div>
          <button onClick={() => !user && setShowLoginModal(true)} className="absolute bottom-4 right-4 text-gray-800 hover:text-gray-600 transition-colors" title="Admin Login"><Lock size={16} /></button>
        </div>
      </footer>

      {/* Login Modal */}
      {showLoginModal && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-in fade-in">
          <div className="bg-gray-800 border border-gray-700 rounded-2xl p-8 max-w-sm w-full shadow-2xl">
            <div className="flex justify-between items-center mb-6">
              <h3 className="text-2xl font-bold text-white">Owner Login</h3>
              <button onClick={() => setShowLoginModal(false)} className="text-gray-400 hover:text-white"><X size={24} /></button>
            </div>
            <form onSubmit={handleLogin} className="space-y-4">
              <div>
                <label className="block text-sm text-gray-400 mb-1">Email</label>
                <input type="email" value={email} onChange={(e) => setEmail(e.target.value)} className="w-full bg-gray-900 border border-gray-600 rounded-lg px-4 py-2 text-white focus:ring-2 focus:ring-blue-500 outline-none" placeholder="admin@mbstech.com" />
              </div>
              <div>
                <label className="block text-sm text-gray-400 mb-1">Password</label>
                <input type="password" value={password} onChange={(e) => setPassword(e.target.value)} className="w-full bg-gray-900 border border-gray-600 rounded-lg px-4 py-2 text-white focus:ring-2 focus:ring-blue-500 outline-none" placeholder="••••••••" />
              </div>
              {authError && <p className="text-red-400 text-sm flex items-center gap-2"><AlertCircle size={14}/> {authError}</p>}
              <button type="submit" className="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg transition-transform hover:scale-105">Login</button>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
